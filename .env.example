# Copy to .env.local and fill in. Everything except AUTH_SECRET is optional for local development.

# Random string used to encrypt sign-in cookies. Generate with: npx auth secret
AUTH_SECRET=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL equivalent).
# When these are empty, a "dev login" form is shown instead (local development only).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Maps JavaScript API key with "Maps JavaScript API" and "Places API (New)" enabled.
# Restrict it to your site's domains (HTTP referrers). Without it, quick-pick spots and "use my location" still work.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Database. Defaults to a local SQLite file. For production use Turso: libsql://<db>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Outgoing email (e.g. Gmail: smtp.gmail.com, port 465, user = the Gmail address, pass = an App Password).
# When SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="IFGF Rides <ifgfrides@gmail.com>"

# Comma-separated emails of ride coordinators (get the /admin dashboard and "needs attention" emails).
ADMIN_EMAILS=

# Public URL of the app, used for links inside emails.
APP_URL=http://localhost:3000
